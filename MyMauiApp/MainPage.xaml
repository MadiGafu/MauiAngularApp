<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyMauiApp.MainPage"
             Title="Plánovač itinerářů">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Obnovit" Clicked="OnRefreshClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto, *" Padding="16">
        <VerticalStackLayout Spacing="12">
            <Label Text="Plánovač itinerářů" FontSize="20" />
            <Button Text="Odeslat zprávu do Angularu" Clicked="OnSendToAngularClicked" />
            <Grid>
                <ActivityIndicator x:Name="spinner" IsVisible="False" IsRunning="False"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
            </Grid>
        </VerticalStackLayout>

        <Grid Grid.Row="1">
            <WebView x:Name="webView"
                     Loaded="OnWebViewLoaded"
                     Navigating="OnWebViewNavigating"
                     Navigated="OnWebViewNavigated" />
            <Label x:Name="webViewError"
                   IsVisible="False"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   TextColor="Red" />
        </Grid>
    </Grid>
</ContentPage>
